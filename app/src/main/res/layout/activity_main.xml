<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <EditText
        android:id="@+id/etAutor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Autor"
        android:inputType="text"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"/>

    <EditText
        android:id="@+id/etNazwa"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Nazwa książki"
        android:inputType="text"
        app:layout_constraintTop_toBottomOf="@id/etAutor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"/>

    <EditText
        android:id="@+id/etGatunek"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Gatunek"
        android:inputType="text"
        app:layout_constraintTop_toBottomOf="@id/etNazwa"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"/>

    <EditText
        android:id="@+id/etIloscStron"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Ilość stron"
        android:inputType="number"
        app:layout_constraintTop_toBottomOf="@id/etGatunek"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"/>

    <Button
        android:id="@+id/btnDodaj"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Dodaj książkę"
        app:layout_constraintTop_toBottomOf="@id/etIloscStron"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnEdytuj"
        android:layout_margin="16dp"/>

    <Button
        android:id="@+id/btnEdytuj"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Edytuj"
        app:layout_constraintTop_toBottomOf="@id/etIloscStron"
        app:layout_constraintStart_toEndOf="@id/btnDodaj"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"/>

    <ListView
        android:id="@+id/listView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/btnDodaj"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
